# Copy to .env for local overrides: cp .env.example .env

# --- local compose ---
POSTGRES_USER=ideas
POSTGRES_PASSWORD=ideas
POSTGRES_DB=ideas
FRONTEND_PORT=8080
BACKEND_PORT=8000
RELEASE_VERSION=dev

# --- AI platform CLI (ai/) ---
# Required for the AI stages. In CI this comes from the ANTHROPIC_API_KEY secret.
ANTHROPIC_API_KEY=
AIOPS_MODEL=claude-sonnet-5
